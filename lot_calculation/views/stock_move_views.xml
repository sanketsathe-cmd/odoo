<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_move_operations_custom" model="ir.ui.view">
        <field name="name">stock.move.operations.form.custom</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="//widget[@name='import_lots']" position="after">
                <widget class="btn btn-link btn-group" name="calculate_lot" 
                        invisible="not display_assign_serial"/>
            </xpath>
        </field>
    </record>
</odoo>