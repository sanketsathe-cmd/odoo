<?xml version="1.0" encoding="utf-8"?>
<templates>
    <div t-name="stock.calculate_lot_dialog">
        <Dialog title="title" size="size">
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-12">
                        <div class="alert alert-info">
                            <strong>Total Quantity:</strong> 
                            <t t-esc="props.move.data.product_uom_qty || 0"/>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Starting Number</label>
                            <input type="number" class="form-control" 
                                   t-model="state.startingNumber"
                                   t-on-input="onInputChange"
                                   min="1"/>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Lots per Package</label>
                            <input type="number" class="form-control" 
                                   t-model="state.lotsPerPackage"
                                   t-on-input="onInputChange"
                                   min="1"/>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Number of Packages</label>
                            <input type="number" class="form-control" 
                                   t-model="state.packagesCount"
                                   t-on-input="onInputChange"
                                   min="1"/>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h6>Preview</h6>
                            </div>
                            <div class="card-body" style="max-height: 300px; overflow-y: auto;">
                                <t t-if="state.previewLots.length === 0">
                                    <p class="text-muted">No lots to preview</p>
                                </t>
                                <t t-else="">
                                    <div t-foreach="state.previewLots" t-as="group" t-key="group_index">
                                        <div class="mb-2">
                                            <strong>Package <t t-esc="group.package"/></strong>
                                            <div class="d-flex flex-wrap">
                                                <span t-foreach="group.lots" t-as="lot" t-key="lot.name" 
                                                      class="badge bg-primary me-1 mb-1">
                                                    <t t-esc="lot.name"/>
                                                    <span class="badge bg-light text-dark ms-1">
                                                        <t t-esc="lot.quantity"/>
                                                    </span>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" t-on-click="props.close">
                    Cancel
                </button>
                <button class="btn btn-primary" t-on-click="_onGenerate">
                    Generate Lots
                </button>
            </div>
        </Dialog>
    </div>

    <div t-name="stock.CalculateLot">
        <button class="btn btn-link" t-on-click="openDialog">
            <i class="fa fa-calculator me-1"/>
            Calculate Lots
        </button>
    </div>
</templates>