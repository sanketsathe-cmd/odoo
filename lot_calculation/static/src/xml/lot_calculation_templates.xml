<?xml version="1.0" encoding="utf-8"?>
<templates>
    <div t-name="stock.calculate_lot_dialog">
        <Dialog title="'Calculation of Lot/Package'" size="'md'">
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-12">
                        <div class="alert alert-info">
                            <strong>Total Quantity:</strong> 
                            <t t-esc="props.move.data.product_uom_qty || 0"/>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Lot No.</label>
                            <input type="text" class="form-control" 
                                   t-model="state.lotNumber"
                                   placeholder="e.g., LOT-A"/>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Qty/Lot</label>
                            <input type="number" class="form-control" 
                                   t-model="state.qtyPerLot"
                                   min="1"
                                   step="1"/>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <button class="btn btn-primary w-100" t-on-click="_onCalculate">
                            <i class="fa fa-calculator me-2"/> Calculate &amp; Copy to Clipboard
                        </button>
                    </div>
                </div>
            </div>
        </Dialog>
    </div>

    <div t-name="stock.CalculateLot">
        <button class="btn btn-link btn-group" t-on-click="openDialog">
            <i class="fa fa-calculator me-1"/>
            Calculate Lots
        </button>
    </div>
</templates>