<odoo>
    <record id="view_ddk_sample_list" model="ir.ui.view">
        <field name="name">ddk.sample.list</field>
        <field name="model">ddk.sample</field>
        <field name="arch" type="xml">
            <list>
                <field name="ddk_name"/>
            </list>
        </field>
    </record>

    <record id="view_ddk_sample_form" model="ir.ui.view">
        <field name="name">ddk.sample.form</field>
        <field name="model">ddk.sample</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="ddk_name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ddk_sample" model="ir.actions.act_window">
        <field name="name">DDK Sample Latest</field>
        <field name="res_model">ddk.sample</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ddk_root" name="DDK" sequence="10"/>
    <menuitem id="menu_ddk_sample" name="Samples" parent="menu_ddk_root" action="action_ddk_sample" sequence="20"/>
</odoo>