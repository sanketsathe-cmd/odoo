<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit tree view -->
    <record id="view_stock_move_line_tree_custom" model="ir.ui.view">
        <field name="name">stock.move.line.tree.custom</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <field name="lot_id" position="after">
                <field name="x_studio_mfg_date_receipt" readonly="0" force_save="1"/>
                <field name="expiration_date" readonly="0" force_save="1"/>
            </field>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_stock_move_line_form_custom" model="ir.ui.view">
        <field name="name">stock.move.line.form.custom</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_form"/>
        <field name="arch" type="xml">
            <field name="lot_id" position="after">
                <field name="x_studio_mfg_date_receipt" readonly="0" force_save="1"/>
                <field name="expiration_date" readonly="0" force_save="1"/>
            </field>
        </field>
    </record>
</odoo>